<section class="scene scene--bone-deep scene-surface" aria-label="Engineering — the clamp" data-scene="04">
  <span class="slate-numeral slate-numeral--right" aria-hidden="true">04</span>
  <div class="scene__inner">
    <span class="mono-label eyebrow">ENGINEERING / 01–04</span>

    <div class="plate">
      <div data-dp-stage="explode">
        <div data-dp-poster>
          {% render 'media-slot',
            url: '',
            kind: 'image',
            aspect: '4 / 3',
            alt: 'Exploded view: plush top, mesh cradle, steel clamp and frame, star-knob screw',
            id: 'SCENE04' %}
        </div>
      </div>

      <dl class="spec-list" data-reveal>
        <div class="spec-list__row">
          <dt><span class="n">01</span><span>PLUSH TOP</span></dt>
          <dd>Cloud-soft. Unzips, machine-washes gentle.</dd>
        </div>
        <div class="spec-list__row">
          <dt><span class="n">02</span><span>MESH CRADLE</span></dt>
          <dd>Breathable weave. Holds shape, stays cool.</dd>
        </div>
        <div class="spec-list__row">
          <dt><span class="n">03</span><span>STEEL CLAMP &amp; FRAME</span></dt>
          <dd>One piece. Holds 22 kg — your cat is not 22 kg.</dd>
        </div>
        <div class="spec-list__row">
          <dt><span class="n">04</span><span>STAR-KNOB SCREW</span></dt>
          <dd>Hand-tight, tool-free. Padded jaws, zero desk marks.</dd>
        </div>
      </dl>
    </div>

    <div class="surface-ritual" data-reveal>
      <div class="surface-ritual__names">
        <span>Walnut.</span><span>White oak.</span><span>Marble.</span><span>Steel.</span>
      </div>
      <div class="surface-ritual__meta">
        <span class="mono-label">FITS EDGES 20–75 MM</span>
        <span class="struck mono-label">
          <svg viewBox="0 0 28 18" style="height:1rem;width:auto;color:var(--ink)" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="26" height="16" stroke="currentColor" stroke-width="1"></rect>
            <line x1="0" y1="18" x2="28" y2="0" stroke="currentColor" stroke-width="1.5"></line>
          </svg>
          NOT FOR GLASS DESKS
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scene 04 — The Grip",
  "settings": []
}
{% endschema %}
