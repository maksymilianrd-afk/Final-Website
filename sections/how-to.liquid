<section class="scene scene-surface" aria-label="How it works" data-scene="09">
  <div class="scene__inner">
    <div class="split">
      <div data-reveal>
        <h2 class="h2">Three turns of a knob.</h2>
        <ol class="steps">
          <li>
            <div><h3><span class="n">1</span>Hook it.</h3><p>Slide the clamp over your desk edge.</p></div>
            <span class="mono-label eyebrow">10 SECONDS</span>
          </li>
          <li>
            <div><h3><span class="n">2</span>Turn it.</h3><p>Tighten the star knob until snug.</p></div>
            <span class="mono-label eyebrow">3 TURNS</span>
          </li>
          <li>
            <div><h3><span class="n">3</span>Done.</h3><p>The spot is theirs.</p></div>
            <span class="mono-label eyebrow">0 TOOLS</span>
          </li>
        </ol>
        <div class="fold-coda">
          <p>Need the space back? Lift, press the side button — it folds flat against the desk.</p>
          <span class="mono-label eyebrow">1 CLICK</span>
        </div>
      </div>

      <div data-dp-stage="knob">
        <div data-dp-poster>
          {% render 'media-slot', url: '', kind: 'image', aspect: '1 / 1', alt: 'The star knob turning through its three detents', id: 'SCENE09' %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scene 09 — How It Works",
  "settings": []
}
{% endschema %}
