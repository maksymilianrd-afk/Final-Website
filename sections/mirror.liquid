<section class="scene scene--night on-night scene-surface" aria-label="5:12 PM, revisited — the resolution" data-scene="07">
  <div aria-hidden="true" style="position:absolute;inset:0;opacity:.4" data-dp-stage="evening">
    {% render 'media-slot', url: settings.media_evening, kind: 'video', aspect: '16 / 9', alt: 'Evening desk scene: lamplight, a cat asleep in the DeskPaws basket, work finished', id: 'HF-V07', class: 'media-slot--fill' %}
  </div>
  <div aria-hidden="true">
    <span class="ghost" style="left:12%;top:18%">✓ sent</span>
    <span class="ghost" style="right:14%;top:36%">✓ done</span>
  </div>
  <div class="scene__inner" data-reveal style="position:relative">
    <p class="mirror-type">
      <span class="masked-line" style="--i:0"><span>The report goes out at 4:58.</span></span>
      <span class="masked-line" style="--i:2"><span>The cat never left.</span></span>
      <span class="masked-line" style="--i:4"><span>Nobody got pushed away.</span></span>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Scene 07 — The Mirror",
  "settings": []
}
{% endschema %}
