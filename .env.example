# Shopify headless commerce (Storefront API)
# Domain of the store, e.g. deskpaws.myshopify.com
SHOPIFY_DOMAIN=
# Storefront API access token (Settings → Apps and sales channels → Develop apps
# → [your app] → Storefront API access token)
SHOPIFY_STOREFRONT_TOKEN=
# Handle of the DeskPaws product in the store (defaults to "deskpaws")
SHOPIFY_PRODUCT_HANDLE=deskpaws
