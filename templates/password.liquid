<section class="hero scene-surface" style="justify-content:center;text-align:center">
  <div>
    {% render 'silhouette', class: '', style: 'height:2rem;width:auto;margin:0 auto 1.5rem;color:var(--ink)' %}
    <h1 class="h2">{{ shop.name }}</h1>
    <p class="lead" style="margin-inline:auto">Opening soon.</p>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="mono-label" style="color:var(--signal);margin-top:1rem">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div style="margin-top:2rem;display:flex;gap:.5rem;justify-content:center">
        <input type="password" name="password" placeholder="Password"
          style="padding:.75rem 1rem;border:1px solid var(--hairline);border-radius:999px;font:inherit;background:transparent">
        <button type="submit" class="cta">Enter</button>
      </div>
    {%- endform -%}
  </div>
</section>
